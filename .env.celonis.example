# Carrier Cost Agent - Celonis Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# CELONIS CONNECTION
# =============================================================================
# Your Celonis cluster URL
CELONIS_BASE_URL=https://<team>.<cluster>.celonis.cloud

# API token (generate in Celonis: User Menu > API Keys)
CELONIS_API_TOKEN=your-api-token-here

# Data Pool ID (find in Celonis Data Integration)
CELONIS_DATA_POOL_ID=your-data-pool-id

# Optional: ML Workbench ID
CELONIS_WORKBENCH_ID=your-workbench-id

# Optional: Object Store bucket for PDFs
CELONIS_OBJECT_STORE_BUCKET=carrier-cost-agent

# =============================================================================
# LLM CONFIGURATION (Celonis Native LLM)
# =============================================================================
# Model names as configured in Celonis AI
LLM_MODEL_CONTRACT_PARSING=celonis-claude-3-5-sonnet
LLM_MODEL_CLAIM_GENERATION=celonis-claude-3-5-sonnet
LLM_MODEL_QA_RESPONSE=celonis-claude-3-5-sonnet

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================
# Batch size for invoice processing
INVOICE_PROCESSING_BATCH_SIZE=100

# Minimum confidence score for anomaly detection
ANOMALY_DETECTION_CONFIDENCE_THRESHOLD=0.5

# Days to look back for duplicate detection
DUPLICATE_LOOKBACK_DAYS=90

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
